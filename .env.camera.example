# BarnSight Edge - Camera Configuration Template
# Copy this file for each camera: cp .env.camera.example .env.cam1
# Then edit the camera-specific values below.

# Camera source - RTSP URL or webcam device index
STREAM_URL=rtsp://192.168.1.100:554/stream

# Unique identifiers for this camera
CAMERA_ID=cam-barn-01
DEVICE_ID=edge-device-01

# API endpoint and authentication
API_URL=http://localhost:8000/api/v1/events
API_KEY=bs_your_api_key_here
REQUIRE_HTTPS=False
API_VERIFY_TLS=True
API_CONNECT_TIMEOUT_SECONDS=3.0
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=2
API_BACKOFF_SECONDS=0.5
EVENT_SEND_WORKERS=2
QUEUE_MAX_SIZE=1000
MAX_IMAGE_BYTES=750000

# Detection thresholds
MIN_CONFIDENCE=0.5
COOLDOWN_SECONDS=1.0

# Region-based deduplication (prevents duplicate images of same spot)
IMAGE_COOLDOWN_SECONDS=5.0
REGION_OVERLAP_THRESHOLD=0.5
REGION_TTL_SECONDS=300.0
REGION_MAX_ENTRIES=512

# Inference performance
INFERENCE_FPS=5.0
IMG_SIZE=640
HALF_PRECISION=False
STREAM_FPS=30
STREAM_RECONNECT_INITIAL_DELAY=0.1
STREAM_RECONNECT_MAX_DELAY=5.0

# Image encoding
JPEG_QUALITY=70

# Display (set True only for debugging, requires X11)
ENABLE_DISPLAY=False
LOG_LEVEL=INFO
