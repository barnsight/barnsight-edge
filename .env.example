# ==========================================
# BarnSight Edge - Configuration Example
# ==========================================

# ------------------------------------------
# Camera & Stream Settings
# ------------------------------------------
# The RTSP URL of your phone camera or IP camera.
# Example: rtsp://192.168.1.100:8080/h264_ulaw.sdp
# If using a local USB webcam, set this to 0.
STREAM_URL=0

# Resolution to capture from the stream
FRAME_WIDTH=640
FRAME_HEIGHT=640
STREAM_FPS=30
STREAM_RECONNECT_INITIAL_DELAY=0.1
STREAM_RECONNECT_MAX_DELAY=5.0
CAMERA_STALE_SECONDS=10.0
CAMERA_FROZEN_SECONDS=30.0

# ------------------------------------------
# Detection Model Settings
# ------------------------------------------
# Path to the YOLO model
MODEL_PATH=models/manure.pt

# Minimum confidence required to register a detection (0.0 to 1.0)
MIN_CONFIDENCE=0.5

# YOLO candidate threshold before app-level filtering. Lower finds more boxes.
DETECTION_CONFIDENCE=0.25

# Safety cap for events created from one frame.
MAX_DETECTIONS_PER_FRAME=20

# ------------------------------------------
# Edge Hardware Optimizations
# ------------------------------------------
# Limit how many times per second YOLO runs (saves CPU/GPU and heat).
# 2.0 to 5.0 is usually enough for static objects like manure.
INFERENCE_FPS=5.0

# Internal YOLO resolution. Lower this (e.g., 416 or 320) if the edge device is lagging.
IMG_SIZE=640

# Set to True if your hardware supports FP16 (usually NVIDIA GPUs/Jetson).
HALF_PRECISION=False

# Keep outbound work bounded on small edge CPUs.
EVENT_SEND_WORKERS=2

# ------------------------------------------
# Event & API Settings
# ------------------------------------------
# The endpoint of your central BarnSight API.
API_URL=http://localhost:8000/api/v1/edge/events

# Use REQUIRE_HTTPS=True outside local development.
REQUIRE_HTTPS=False
API_VERIFY_TLS=True
API_CONNECT_TIMEOUT_SECONDS=3.0
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=2
API_BACKOFF_SECONDS=0.5

# Your API Key for authentication (must start with bs_).
API_KEY=bs_YOUR_GENERATED_KEY_HERE

# Unique identifiers for this specific device and camera.
DEVICE_ID=edge-device-01
CAMERA_ID=camera-01

# Queue and payload limits for offline operation.
QUEUE_BACKEND=memory
QUEUE_DB_PATH=data/events_queue.sqlite3
QUEUE_MAX_RETRY_COUNT=0
QUEUE_STORE_IMAGES=False
QUEUE_MAX_SIZE=1000
MAX_IMAGE_BYTES=750000

# How many seconds to wait before sending another event globally.
COOLDOWN_SECONDS=1.0

# ------------------------------------------
# Image & Region Deduplication
# ------------------------------------------
JPEG_QUALITY=70
IMAGE_COOLDOWN_SECONDS=5.0
REGION_OVERLAP_THRESHOLD=0.5
REGION_TTL_SECONDS=300.0
REGION_MAX_ENTRIES=512

# ------------------------------------------
# Developer Tools
# ------------------------------------------
# Set to True to open an OpenCV window and see live bounding boxes.
ENABLE_DISPLAY=False
LOG_LEVEL=INFO
